{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furia.dev/schemas/bod-cuas.airport-pack.schema.json",
  "title": "BOD-CUAS airport-pack manifest",
  "description": "Generic, airport-specific manifest. It contains references only; operational authority remains outside the pack.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "id", "display_name", "authority_boundary", "components"],
  "properties": {
    "schema": { "const": "bod-cuas.airport-pack" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "authority_boundary": { "enum": ["context_only", "training_only"] },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "geodata", "sensors", "sectors", "scenarios"],
      "properties": {
        "identity": { "$ref": "#/$defs/reference" },
        "geodata": { "$ref": "#/$defs/reference" },
        "sensors": { "$ref": "#/$defs/reference" },
        "sectors": { "$ref": "#/$defs/reference" },
        "scenarios": { "$ref": "#/$defs/reference" }
      }
    },
    "profile": { "$ref": "#/$defs/reference" },
    "catalogue": { "$ref": "#/$defs/reference" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator_profile": { "$ref": "#/$defs/reference" },
        "legacy_geodata": { "$ref": "#/$defs/reference" }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)[^#]+$"
    }
  }
}
